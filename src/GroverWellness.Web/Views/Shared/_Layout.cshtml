<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Grover Wellness</title>

    <meta name="description"
          content="Grover Wellness helps people explore better health and additional income through education, trust, and personal guidance." />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/GroverWellness.Web.styles.css"
          asp-append-version="true" />
</head>

<body>
    <header class="gw-header">
        <div class="container gw-nav-container">
            <a class="gw-brand"
               asp-controller="Home"
               asp-action="Index">
                <span class="gw-brand-mark">G</span>

                <span class="gw-brand-text">
                    <strong>Grover</strong>
                    <small>Wellness</small>
                </span>
            </a>

            <button class="gw-nav-toggle"
                    type="button"
                    aria-controls="gwNavigation"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span></span>
                <span></span>
                <span></span>
            </button>

            <nav id="gwNavigation" class="gw-navigation">
                <a asp-controller="Home" asp-action="Index">Home</a>

                <a href="#about">
                    About Michael
                </a>

                <a href="#health">
                    Better Health
                </a>

                <a href="#opportunity">
                    Income Opportunity
                </a>

                <a class="gw-nav-button"
                   href="#contact">
                    Let’s Connect
                </a>
            </nav>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="gw-footer">
        <div class="container">
            <div class="gw-footer-grid">
                <div>
                    <a class="gw-brand gw-footer-brand"
                       asp-controller="Home"
                       asp-action="Index">
                        <span class="gw-brand-mark">G</span>

                        <span class="gw-brand-text">
                            <strong>Grover</strong>
                            <small>Wellness</small>
                        </span>
                    </a>

                    <p>
                        Helping people explore better health and additional
                        income through education, trust, and personal guidance.
                    </p>
                </div>

                <div>
                    <h3>Explore</h3>
                    <a href="#health">Better Health</a>
                    <a href="#opportunity">Income Opportunity</a>
                    <a href="#about">About Michael</a>
                </div>

                <div>
                    <h3>Connect</h3>
                    <a href="#contact">Contact Michael</a>
                    <a href="#">Privacy</a>
                </div>
            </div>

            <div class="gw-footer-bottom">
                <p>
                    © @DateTime.Now.Year Grover Wellness.
                </p>

                <p>
                    Independent Zinzino Partner.
                </p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>